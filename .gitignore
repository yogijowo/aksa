# ============================================================================
# AKSA Monorepo .gitignore (Tauri v2 + React + Rust + Python FastAPI + uv)
# ============================================================================

# ----------------------------------------------------------------------------
# 1. Node.js, Vite & Frontend Build Artifacts (apps/desktop)
# ----------------------------------------------------------------------------
**/node_modules/
**/dist/
**/dist-ssr/
**/.vite/
*.tsbuildinfo
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.pnpm-store/

# ----------------------------------------------------------------------------
# 2. Tauri v2 & Rust Build Artifacts (apps/desktop/src-tauri)
# ----------------------------------------------------------------------------
**/src-tauri/target/
**/src-tauri/gen/schemas/
**/src-tauri/WixTools/
**/src-tauri/binaries/*
!**/src-tauri/binaries/.gitkeep
*.pdb
*.msi
*.exe
*.dmg
*.app

# ----------------------------------------------------------------------------
# 3. Python, uv, Pytest & PyInstaller (services/engine)
# ----------------------------------------------------------------------------
**/__pycache__/
*.py[cod]
*$py.class
*.so
.Python
**/.venv/
**/venv/
ENV/
env/
.uv/
build/
develop-eggs/
eggs/
.eggs/
services/engine/lib/
services/engine/lib64/
!apps/desktop/src/lib/
!apps/desktop/src/lib/**
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
*.spec
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/

# ----------------------------------------------------------------------------
# 4. AKSA Local Databases, RAG Index, Backups & Environment Secrets
# ----------------------------------------------------------------------------
.env
.env.*
!.env.example
*.db
*.db-shm
*.db-wal
*.sqlite
*.sqlite3
lancedb/
.aksa/
.aksa_backup/
logs/
*.log

# ----------------------------------------------------------------------------
# 5. OS & IDE / Editor Files (Windows & macOS)
# ----------------------------------------------------------------------------
.DS_Store
.AppleDouble
.LSOverride
._*
*:*
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
.idea/
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
*.swp
*.swo
*~

# ----------------------------------------------------------------------------
# 6. Generated Office Documents, Test Exports & User Workspace Files
# ----------------------------------------------------------------------------
*.xlsx
*.docx
*.pptx
*.pdf
!docs/**/*.pdf
!docs/**/*.docx
!templates/**/*.xlsx
!templates/**/*.docx
!templates/**/*.pptx


