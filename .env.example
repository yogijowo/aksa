# ==============================================================================
# AKSA Desktop Platform — Environment Configuration Template
# ==============================================================================
# Copy this file to .env or configure API keys directly inside the Desktop UI.
# Never commit real API keys or credentials to version control.

# ------------------------------------------------------------------------------
# 1. Core Engine Runtime
# ------------------------------------------------------------------------------
AKSA_HOST=127.0.0.1
AKSA_PORT=43120
AKSA_DEV_MODE=true
# Optional token for sidecar handshake protection
AKSA_AUTH_TOKEN=dev-aksa-local-token

# ------------------------------------------------------------------------------
# 2. Local AI Endpoints (100% Free & Private)
# ------------------------------------------------------------------------------
OLLAMA_BASE_URL=http://127.0.0.1:11434
LMSTUDIO_BASE_URL=http://127.0.0.1:1234/v1

# ------------------------------------------------------------------------------
# 3. Cloud LLM Providers (Optional — Can be entered in Desktop Settings UI)
# ------------------------------------------------------------------------------
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
DEEPSEEK_API_KEY=
OPENROUTER_API_KEY=
GROQ_API_KEY=

# ------------------------------------------------------------------------------
# 4. Telegram Remote Command Center (Optional)
# ------------------------------------------------------------------------------
# Obtain token from @BotFather on Telegram
TELEGRAM_BOT_TOKEN=
